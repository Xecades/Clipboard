# Environment variables for Clipboard application

# JWT Secret Key (REQUIRED in production)
# Generate a secure random key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-secret-key-change-in-production

# Clipboard access password
CLIPBOARD_PASSWORD=123456

# Server configuration
HOST=0.0.0.0
PORT=8000

# Security configuration
# Domain allowed for CORS (e.g., yourdomain.com)
ALLOWED_DOMAIN=yourdomain.com
